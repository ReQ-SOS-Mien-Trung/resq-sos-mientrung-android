<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Main Navigation Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navBarCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/nav_bar_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Home Tab -->
            <FrameLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/tabHomeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <View
                        android:id="@+id/tabHomePill"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/nav_pill_background"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/iconHome"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:padding="2dp"
                        android:src="@drawable/ic_home"
                        app:tint="@color/nav_icon_unselected" />
                </FrameLayout>
            </FrameLayout>

            <!-- Chat Tab -->
            <FrameLayout
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/tabChatContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <View
                        android:id="@+id/tabChatPill"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/nav_pill_background"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/iconChat"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:padding="2dp"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/nav_icon_unselected" />
                </FrameLayout>
            </FrameLayout>

            <!-- Users Tab -->
            <FrameLayout
                android:id="@+id/tabUsers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/tabUsersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <View
                        android:id="@+id/tabUsersPill"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/nav_pill_background"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/iconUsers"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:padding="2dp"
                        android:src="@drawable/ic_users"
                        app:tint="@color/nav_icon_unselected" />
                </FrameLayout>
            </FrameLayout>

            <!-- More Tab (Rescuers) -->
            <FrameLayout
                android:id="@+id/tabRescuers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/tabRescuersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <View
                        android:id="@+id/tabRescuersPill"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/nav_pill_background"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/iconRescuers"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:padding="2dp"
                        android:src="@drawable/ic_more"
                        app:tint="@color/nav_icon_unselected" />
                </FrameLayout>
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Map FAB (Floating Action Button) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tabMap"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/nav_fab_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconMap"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_map"
            app:tint="@color/white" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
