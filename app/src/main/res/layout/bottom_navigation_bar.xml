<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/nav_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Animated Background Indicator -->
        <View
            android:id="@+id/selectedTabIndicator"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/nav_tab_background"
            android:alpha="0.0"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Rescuers Tab -->
            <FrameLayout
                android:id="@+id/tabRescuers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iconRescuers"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_rescuers"
                        android:tint="@color/nav_selected" />

                    <TextView
                        android:id="@+id/textRescuersTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rescuers"
                        android:textSize="12sp"
                        android:textColor="@color/nav_selected"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </FrameLayout>

            <!-- Users Tab -->
            <FrameLayout
                android:id="@+id/tabUsers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iconUsers"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_users"
                        android:tint="@color/nav_unselected" />

                    <TextView
                        android:id="@+id/textUsersTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Users"
                        android:textSize="12sp"
                        android:textColor="@color/nav_unselected"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </FrameLayout>

            <!-- Chat Tab -->
            <FrameLayout
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iconChat"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chat"
                        android:tint="@color/nav_unselected" />

                    <TextView
                        android:id="@+id/textChatTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat"
                        android:textSize="12sp"
                        android:textColor="@color/nav_unselected"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </FrameLayout>

            <!-- Map Tab -->
            <FrameLayout
                android:id="@+id/tabMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iconMap"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_map"
                        android:tint="@color/nav_unselected" />

                    <TextView
                        android:id="@+id/textMapTab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Map"
                        android:textSize="12sp"
                        android:textColor="@color/nav_unselected"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
