<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orange_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutChat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/nav_background"
        android:elevation="4dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutTitleChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/titleChat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chat Offline"
                    android:textSize="22sp"
                    android:textColor="@color/orange_primary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/status_container"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <View
                        android:id="@+id/statusIndicatorChat"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bridgefy_status_indicator"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/textBridgefyStatusChat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang khởi động..."
                        android:textSize="11sp"
                        android:textColor="@color/nav_unselected"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/layoutMessageInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/nav_background"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/editTextMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nhập tin nhắn..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/message_input_background"
            android:textColorHint="@color/nav_unselected"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:maxLines="3"
            android:minHeight="48dp"
            android:gravity="center_vertical" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/buttonSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="Gửi tin nhắn"
            app:tint="@color/white"
            app:backgroundTint="@color/orange_primary"
            app:fabSize="normal"
            app:elevation="4dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/appBarLayoutChat"
        app:layout_constraintBottom_toTopOf="@id/layoutMessageInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutEmptyStateChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/appBarLayoutChat"
        app:layout_constraintBottom_toTopOf="@id/layoutMessageInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_chat"
            android:tint="@color/nav_unselected"
            android:alpha="0.5"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/textNoMessages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa có tin nhắn"
            android:textSize="18sp"
            android:textColor="@color/orange_primary"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textEmptySubtitleChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kết nối với người dùng gần đây để bắt đầu chat offline"
            android:textSize="14sp"
            android:textColor="@color/nav_unselected"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:alpha="0.7" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
