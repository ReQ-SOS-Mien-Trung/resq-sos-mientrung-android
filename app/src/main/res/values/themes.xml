<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Light Mode (Optional) -->
    <style name="Base.Theme.ResqSOSMienTrungAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Light theme colors -->
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryDark">@color/orange_primary_dark</item>
        <item name="colorAccent">@color/orange_accent</item>
        <item name="android:windowBackground">@color/orange_background</item>
        <item name="android:statusBarColor">@color/orange_background</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
    </style>

    <style name="Theme.ResqSOSMienTrungAndroid" parent="Base.Theme.ResqSOSMienTrungAndroid" />
    
    <!-- Bottom Sheet Dialog Theme -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    
    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>