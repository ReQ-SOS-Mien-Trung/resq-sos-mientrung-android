<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Dark Mode (Default for battery saving) -->
    <style name="Base.Theme.ResqSOSMienTrungAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Dark theme colors optimized for battery saving -->
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryDark">@color/orange_primary_dark</item>
        <item name="colorAccent">@color/orange_accent</item>
        <item name="android:windowBackground">@color/orange_background</item>
        <item name="android:statusBarColor">@color/orange_background</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <!-- Force dark mode for battery optimization -->
        <item name="android:forceDarkAllowed">true</item>
    </style>
</resources>